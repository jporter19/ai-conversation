# Copy to /etc/ai-conversation/env on the server (mode 600).
# Do not commit real secrets.

# Durable data (outside /opt so deploys don't wipe it)
AI_HUB_DATA_DIR=/var/lib/ai-conversation/data

# Auth — leave AUTH_DISABLED unset/false in production
# AUTH_DISABLED=0
SESSION_SECRET=replace-with-long-random-hex
# SESSION_HTTPS_ONLY=1   # set after HTTPS is enabled

# Shared hub account is in $AI_HUB_DATA_DIR/users.json (preferred)
# Or set AUTH_USERS JSON (overrides file):
# AUTH_USERS=[{"username":"hub","password_hash":"$2b$..."}]

# Provider API keys (optional if you paste keys via Admin after login)
# XAI_API_KEY=
# OPENAI_API_KEY=
# MAGISTERIUM_API_KEY=
# YOUTUBE_API_KEY=

# YouTube transcripts on AWS: YouTube blocks cloud IPs.
# Preferred: home-PC relay (SSH reverse tunnel) — see scripts/transcript_relay.py
# YOUTUBE_TRANSCRIPT_RELAY_URL=http://127.0.0.1:8791
# YOUTUBE_TRANSCRIPT_RELAY_TOKEN=long-random-shared-secret
# YOUTUBE_TRANSCRIPT_RELAY_TIMEOUT=90
#
# Alternative: rotating residential proxies (Webshare "Residential" only):
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# Or generic:
# YOUTUBE_PROXY_URL=http://user:pass@host:port


