# Copy to /etc/ai-conversation/env on the server (mode 600).
# Do not commit real secrets.

# Durable data (outside /opt so deploys don't wipe it)
AI_HUB_DATA_DIR=/var/lib/ai-conversation/data

# ── Porter Family Portal SSO (required in production) ─────────────────────────
# Must match portal-admin PORTAL_SESSION_SECRET exactly
PORTAL_SESSION_SECRET=replace-with-same-long-random-as-portal-admin
PORTAL_SESSION_COOKIE=portal_session
PORTAL_LOGIN_URL=/admin/login
# REQUIRED for www + apex to share the session (otherwise Brave often
# lands on www, Firefox on apex, and AI asks you to log in again).
PORTAL_COOKIE_DOMAIN=.porterfamily.us
APP_ID=ai-conversation
# Public shell path on the family domain (portal owns apex /)
APP_HOME_PATH=/chat/

# Assign pre-SSO flat data (conversations/media) to this portal user_id once
# PORTAL_LEGACY_OWNER_USER_ID=<portal-admin-user-uuid>

# Local laptop only — skip portal cookie, use fake admin user "dev"
# AUTH_DISABLED=1

# Portal-admin issues Secure cookies; AI only verifies, does not re-issue.

# Provider API keys (optional if you paste keys via Admin after login)
# XAI_API_KEY=
# OPENAI_API_KEY=
# MAGISTERIUM_API_KEY=
# YOUTUBE_API_KEY=

# YouTube transcripts on AWS: YouTube blocks cloud IPs.
# Preferred: home-PC relay (SSH reverse tunnel) — see scripts/transcript_relay.py
# YOUTUBE_TRANSCRIPT_RELAY_URL=http://127.0.0.1:8791
# YOUTUBE_TRANSCRIPT_RELAY_TOKEN=long-random-shared-secret
